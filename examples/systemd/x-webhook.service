[Unit]
Description=X webhook receiver for crosspost automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/x-crosspost
EnvironmentFile=/opt/x-crosspost/.env
ExecStart=/usr/bin/task x:webhook
Restart=on-failure
RestartSec=5

# Keep the repo writable so the remediation agent can patch files locally.
ProtectSystem=off
ProtectHome=false
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=x-webhook
