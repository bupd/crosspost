# Load this file locally with CROSSPOST_DOTENV=1, or copy it to .env.
# Do not commit real tokens.

# X source account
X_BEARER_TOKEN=
X_USER_ID=
# X_USERNAME=yourhandle

# X webhook receiver. Use your X app consumer secret for CRC/signature checks.
X_WEBHOOK_CONSUMER_SECRET=
X_WEBHOOK_HOST=0.0.0.0
X_WEBHOOK_PORT=8787
X_WEBHOOK_PATH=/webhooks/x
# X_WEBHOOK_COMMAND=task x:supervise

# Bluesky target
BLUESKY_HOST=bsky.social
BLUESKY_IDENTIFIER=
BLUESKY_PASSWORD=

# Mastodon target
MASTODON_HOST=
MASTODON_ACCESS_TOKEN=

# LinkedIn target, optional unless you want hashtag/thread posts there
LINKEDIN_ACCESS_TOKEN=

# Crosspost behavior
CROSSPOST_DOTENV=1
X_CROSSPOST_STATE_FILE=.crosspost-state.json
X_CROSSPOST_LOOKBACK_LIMIT=20
X_CROSSPOST_LINKEDIN_SETTLE_MINUTES=10
# X_CROSSPOST_DRY_RUN=1
# X_CROSSPOST_BOOTSTRAP=1

# Local failure remediation
X_CROSSPOST_REMEDIATE=1
X_CROSSPOST_AGENT=opencode
# X_CROSSPOST_AGENT=codex
# X_CROSSPOST_AGENT_COMMAND=opencode run "$(cat \"$PROMPT_FILE\")"
X_CROSSPOST_RERUN_AFTER_REMEDIATION=1
